{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "drafter",
  "compatibility_date": "2026-09-13",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "drafter.johnhooks.io", "custom_domain": true }
  ]
}
